{
  "name": "obochina",
  "version": "0.18.1",
  "private": true,
  "description": "Браузерная игра «Обочина» на чистом JS",
  "scripts": {
    "start": "node serve.js . 8124",
    "balance:zone": "node tests/zone-balance-report.js",
